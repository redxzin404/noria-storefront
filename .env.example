DATABASE_URL="file:./dev.db"
# For Vercel/Neon deployment, use the pooled connection URL instead.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Set both flags to true only for a public, non-transactional demo.
# NORIA_DEMO_MODE="true"
# NEXT_PUBLIC_NORIA_DEMO_MODE="true"
ADMIN_EMAIL="admin@noria.local"
ADMIN_PASSWORD="replace-with-a-strong-password"
CRON_SECRET="replace-with-a-long-random-secret"

# Mercado Pago Checkout Pro. Start with a TEST- prefixed sandbox token.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
MERCADOPAGO_ENVIRONMENT="sandbox"

# Public HTTPS origin needed for return URLs and Mercado Pago webhooks.
NORIA_APP_URL="http://localhost:3000"

# Melhor Envio API. Start with an OAuth token from its sandbox environment.
MELHORENVIO_ACCESS_TOKEN=""
MELHORENVIO_ENVIRONMENT="sandbox"
STORE_ORIGIN_POSTAL_CODE=""
STORE_CONTACT_EMAIL="suporte@example.com"
